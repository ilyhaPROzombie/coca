{
  "extends": ["stylelint-config-standard"],
  "plugins": [
    "stylelint-order"
  ],
  "rules": {
    "order/properties-order": [
      "position",
      "top",
      "right",
      "bottom",
      "left",
      "z-index",
      "display",
      "flex-direction",
      "justify-content",
      "align-items",
      "width",
      "height",
      "margin",
      "padding",
      "font-size",
      "line-height",
      "color",
      "background",
      "border"
    ]
  }
}